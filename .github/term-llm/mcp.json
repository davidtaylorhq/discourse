{
  "servers": {
    "github": {
      "command": "ssh",
      "args": [
        "-i", "/home/discourse/.ssh/gate",
        "-p", "__SSH_PORT__",
        "-o", "StrictHostKeyChecking=no",
        "-o", "UserKnownHostsFile=/dev/null",
        "__GATE_USER__@host.docker.internal",
        "mcp"
      ]
    }
  }
}
