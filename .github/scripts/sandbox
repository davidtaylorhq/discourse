#!/bin/bash
# Run a command inside the Discourse dev container, booting it on first use.
#
# The agent is allowed to run this script and never `docker` itself, because
# `docker run` takes arguments like `-v /:/host` and `-e SOME_TOKEN` that would
# reach straight out of the sandbox. Every flag below is fixed here.
#
# Git runs in here too. The container has its own git directory, on its own
# filesystem, and reaches the runner's repository only through the relay, so
# nothing it writes can be executed by the runner.
set -euo pipefail

CONTAINER=discourse_sandbox
IMAGE=discourse/discourse_dev:release
SRC="${SANDBOX_SRC:-$PWD}"
GITDIR=/home/discourse/gitdir
RELAY=git://host.docker.internal/relay.git
LOCK="${RUNNER_TEMP:-/tmp}/sandbox.lock"

log() { echo "[sandbox] $*" >&2; }

running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || echo false)" = true ]
}

in_container() {
  docker exec -i \
    -u discourse \
    -w /src \
    -e CI=1 \
    -e RAILS_ENV \
    -e GIT_DIR="$GITDIR" \
    -e GIT_WORK_TREE=/src \
    "$CONTAINER" \
    bash -lc "$1"
}

boot() {
  log "booting $IMAGE (first use; this takes a few minutes)"
  mkdir -p "$SRC/data/postgres"

  docker run -d \
    --name "$CONTAINER" \
    --hostname discourse \
    --add-host host.docker.internal:host-gateway \
    -v "$SRC:/src" \
    -v "$SRC/data/postgres:/shared/postgres_data" \
    "$IMAGE" /sbin/boot >/dev/null

  # Renumber the container's user to the host's before anything runs as it.
  # `usermod` refuses while that user owns a process, and the shared /src mount
  # is unusable from one side or the other until the two uids agree.
  local uid gid
  uid=$(id -u)
  gid=$(id -g)
  docker exec -u root "$CONTAINER" bash -c "
    set -e
    if id -u $uid >/dev/null 2>&1 && [ \"\$(id -un $uid)\" != discourse ]; then
      echo 'uid $uid is already taken inside the container' >&2
      exit 1
    fi
    usermod  -u $uid discourse
    groupmod -g $gid discourse
    chown -R $uid:$gid /home/discourse
  "
  log "container user renumbered to $uid:$gid"

  log "fetching the branch from the relay"
  in_container "
    set -e
    git init -q --bare '$GITDIR'
    git config core.bare false
    git remote add origin '$RELAY'
    git fetch -q --depth 1 origin '+refs/heads/${HEAD_REF}:refs/heads/${HEAD_REF}'
    git symbolic-ref HEAD 'refs/heads/${HEAD_REF}'
    git reset -q --mixed
    git config user.name  'discoursebot'
    git config user.email 'discoursebot@users.noreply.github.com'
  "

  log "waiting for postgres"
  local i
  for i in $(seq 1 60); do
    if docker exec -u root "$CONTAINER" pg_isready -q 2>/dev/null; then break; fi
    sleep 2
  done

  log "installing gems"
  in_container "bundle install --jobs $(nproc) --retry 3"
  log "installing node modules"
  in_container "pnpm install --frozen-lockfile"
  log "migrating"
  in_container "bin/rake db:create db:migrate"
  in_container "RAILS_ENV=test bin/rake db:create db:migrate"
  log "ready"
}

if [ "$#" -eq 0 ]; then
  echo "usage: sandbox <command>" >&2
  exit 64
fi

exec 9>"$LOCK"
flock 9
running || boot
exec 9>&-

in_container "$*"
