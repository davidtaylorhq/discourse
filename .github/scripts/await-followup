#!/usr/bin/env python3
"""Wait a little to see whether the conversation continues.

The sandbox is still up, with the branch cloned and any development
environment running, so answering a follow-up here costs seconds where a fresh
run costs a minute. A comment this claims is marked as claimed, and the run it
triggers stands down on seeing that.
"""
import json
import os
import pathlib
import subprocess
import sys
import time

WINDOW = int(os.environ.get("FOLLOWUP_WINDOW", "60"))  # also names the checklist line
POLL = 3
ALLOWED = {"OWNER", "MEMBER", "COLLABORATOR"}
MACRO = "@discoursebot"


CLAIM = "rocket"


def gh(args, quiet=False):
    p = subprocess.run(["gh", "api", *args], input="", capture_output=True, text=True)
    if p.returncode != 0 and not quiet:
        print(f"gh api {' '.join(args)}: {p.stderr.strip()}", file=sys.stderr)
    return p.stdout if p.returncode == 0 else ""


def is_claimed(repo, comment_id):
    """A reaction from us means some run has taken this one on."""
    raw = gh(["--paginate", f"repos/{repo}/issues/comments/{comment_id}/reactions"])
    for page in raw.splitlines():
        try:
            for r in json.loads(page):
                if r.get("content") == CLAIM and r["user"]["login"].endswith("[bot]"):
                    return True
        except json.JSONDecodeError:
            pass
    return False


def candidates(repo, issue, after):
    found = []
    for page in gh(["--paginate", f"repos/{repo}/issues/{issue}/comments"]).splitlines():
        try:
            items = json.loads(page)
        except json.JSONDecodeError:
            continue
        for c in items:
            if c["created_at"] <= after:
                continue
            if c["user"]["login"].endswith("[bot]"):
                continue
            if c.get("author_association") not in ALLOWED:
                continue
            if MACRO not in (c.get("body") or ""):
                continue
            found.append(c)
    return found


def claim(repo, comment_id):
    """Take this one on, where the run it triggered can see that we have.

    One call that either works or says why. Editing a comment to leave a note
    was two calls, and the failure of the second was invisible.
    """
    p = subprocess.run(
        ["gh", "api", "--method", "POST",
         f"/repos/{repo}/issues/comments/{comment_id}/reactions",
         "-f", f"content={CLAIM}"],
        input="", capture_output=True, text=True,
    )
    if p.returncode != 0:
        print(f"could not claim comment {comment_id}: {p.stderr.strip()}", file=sys.stderr)
        return False
    return True


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    issue = os.environ["ISSUE_NUMBER"]
    after = os.environ["SINCE"]
    out = pathlib.Path(os.environ["FOLLOWUP_FILE"])

    deadline = time.time() + WINDOW
    while time.time() < deadline:
        for c in candidates(repo, issue, after):
            if is_claimed(repo, c["id"]) or not claim(repo, c["id"]):
                continue
            out.write_text(json.dumps({
                "id": c["id"], "author": c["user"]["login"], "body": c["body"],
            }))
            print(f"picked up a follow-up from {c['user']['login']}", file=sys.stderr)
            return 0
        time.sleep(POLL)

    print("nothing further; stopping", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
