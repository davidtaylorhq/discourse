#!/usr/bin/env python3
"""Keep the run's opening comment up to date as a checklist.

The steps are not fixed: booting a development environment adds its own, so the
comment says what this run actually did rather than what a run might do.
"""
import json
import os
import pathlib
import subprocess
import sys

# Not a task list: anyone reading can tick those, and this would then spend the
# run arguing with them. The unfinished mark is a plain circle rather than an
# emoji square, so it takes the colour of whatever theme is reading it instead
# of being a pale block on a dark page.
# One drawing in three states: the same ring throughout, with a gap that turns
# while something is happening and a check once it is done. Greens and oranges
# that hold up on either background, so one file each rather than a pair.
ASSETS = "https://raw.githubusercontent.com/{repo}/{ref}/.github/assets"
MARK = {
    "done": ("mark-done.svg", "done"),
    "active": ("mark-active.svg", "in progress"),
    "pending": ("mark-pending.svg", "not started"),
}
STATE = pathlib.Path(os.environ.get("PROGRESS_FILE", "/tmp/progress.json"))
WINDOW = os.environ.get("FOLLOWUP_WINDOW", "60")


def render(steps):
    assets = ASSETS.format(
        repo=os.environ.get("GITHUB_REPOSITORY", ""),
        ref=os.environ.get("ASSET_REF", "main"),
    )
    lines = []
    for s in steps:
        name, alt = MARK[s["state"]]
        mark = f'<img src="{assets}/{name}" width="13" height="13" alt="{alt}">'
        lines.append(f"{mark} {s['label']}")
    run = os.environ.get("RUN_URL", "")
    body = "\n".join(lines)
    return f"{body}\n\n<sub>[Run log]({run})</sub>" if run else body


def publish(steps):
    STATE.write_text(json.dumps(steps))
    comment = os.environ.get("COMMENT_ID")
    repo = os.environ.get("GITHUB_REPOSITORY")
    if not comment or not repo:
        return
    subprocess.run(
        ["gh", "api", "--method", "PATCH",
         f"/repos/{repo}/issues/comments/{comment}",
         "-f", f"body={render(steps)}"],
        input="", capture_output=True, text=True,
    )


def load():
    return json.loads(STATE.read_text()) if STATE.exists() else []


def main(argv):
    if not argv:
        print("usage: progress init|set|complete|append|insert-before ...", file=sys.stderr)
        return 64

    cmd, *rest = argv

    if cmd == "init":
        steps = [{"key": k, "label": l, "state": s} for k, l, s in (
            ("sandbox", "Preparing the sandbox", "active"),
            ("working", "Working", "pending"),
            ("replying", "Replying", "pending"),
            ("waiting", f"Waiting {WINDOW}s for further instructions", "pending"),
        )]
        publish(steps)
        return 0

    steps = load()

    if cmd == "complete":
        # Whatever is in progress, without the caller having to know which:
        # a development environment adds a second stretch of work, so the
        # step that finishes is not always the one that started.
        for step in steps:
            if step["state"] == "active":
                step["state"] = "done"
        publish(steps)
        return 0

    if cmd == "set":
        key, state = rest[0], rest[1]
        for s in steps:
            if s["key"] == key:
                s["state"] = state
        publish(steps)
        return 0

    if cmd == "append":
        # Each round of the conversation adds its own lines, so the list reads
        # as a record of what happened rather than one that rewrites itself.
        for pair in rest:
            key, _, label = pair.partition("=")
            if not any(step["key"] == key for step in steps):
                steps.append({"key": key, "label": label, "state": "pending"})
        publish(steps)
        return 0

    if cmd == "insert-before":
        anchor, *pairs = rest
        new = []
        for p in pairs:
            key, _, label = p.partition("=")
            if any(s["key"] == key for s in steps):
                continue
            new.append({"key": key, "label": label, "state": "pending"})
        if new:
            at = next((i for i, s in enumerate(steps) if s["key"] == anchor), None)
            if at is None:
                print(f"no step called {anchor} to insert before", file=sys.stderr)
                return 1
            steps[at:at] = new
            publish(steps)
        return 0

    print(f"unknown command {cmd}", file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
