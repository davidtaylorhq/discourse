#!/usr/bin/env python3
"""Keep the run's opening comment up to date as a checklist.

The steps are not fixed: booting a development environment adds its own, so the
comment says what this run actually did rather than what a run might do.
"""
import json
import os
import pathlib
import subprocess
import sys

MARK = {"done": "✅", "active": "⏳", "pending": "⬜"}
STATE = pathlib.Path(os.environ.get("PROGRESS_FILE", "/tmp/progress.json"))


def render(steps):
    lines = [f"{MARK[s['state']]} {s['label']}" for s in steps]
    run = os.environ.get("RUN_URL", "")
    body = "\n".join(lines)
    return f"{body}\n\n<sub>[Run log]({run})</sub>" if run else body


def publish(steps):
    STATE.write_text(json.dumps(steps))
    comment = os.environ.get("COMMENT_ID")
    repo = os.environ.get("GITHUB_REPOSITORY")
    if not comment or not repo:
        return
    subprocess.run(
        ["gh", "api", "--method", "PATCH",
         f"/repos/{repo}/issues/comments/{comment}",
         "-f", f"body={render(steps)}"],
        input="", capture_output=True, text=True,
    )


def load():
    return json.loads(STATE.read_text()) if STATE.exists() else []


def main(argv):
    if not argv:
        print("usage: progress init|set|insert-before ...", file=sys.stderr)
        return 64

    cmd, *rest = argv

    if cmd == "init":
        steps = [{"key": k, "label": l, "state": s} for k, l, s in (
            ("started", "Workflow started", "done"),
            ("agent_started", "Agent started", "active"),
            ("agent", "Agent running", "pending"),
            ("responded", "Responded", "pending"),
        )]
        publish(steps)
        return 0

    steps = load()

    if cmd == "set":
        key, state = rest[0], rest[1]
        for s in steps:
            if s["key"] == key:
                s["state"] = state
        publish(steps)
        return 0

    if cmd == "insert-before":
        anchor, *pairs = rest
        new = []
        for p in pairs:
            key, _, label = p.partition("=")
            if any(s["key"] == key for s in steps):
                continue
            new.append({"key": key, "label": label, "state": "pending"})
        if new:
            at = next((i for i, s in enumerate(steps) if s["key"] == anchor), len(steps))
            steps[at:at] = new
            publish(steps)
        return 0

    print(f"unknown command {cmd}", file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
