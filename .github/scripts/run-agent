#!/bin/bash
# Boot the sandbox and run the agent in it.
#
# The container has no volumes and no credentials. It reaches the runner only
# through the ssh gate, for the repository and for GitHub, and through an HTTP
# endpoint for inference. Because there is nothing in there worth taking, the
# agent runs with approvals off.
set -euo pipefail

: "${RUNNER_TEMP:?}" "${BRIDGE_IP:?}" "${SSH_PORT:?}" "${SERVE_PORT:?}"
: "${SERVE_TOKEN:?}" "${CLIENT_KEY:?}" "${HEAD_REF:?}" "${AGENT_DIR:?}"
: "${GATE_USER:?}"
: "${TERM_LLM_VERSION:?}"

CONTAINER=discourse_sandbox
IMAGE=discourse/discourse_dev:release
SSH_CMD="ssh -i /home/discourse/.ssh/gate -p $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

log() { echo "[sandbox] $*" >&2; }

as_agent() {
  docker exec -i -u discourse -w /src \
    -e CI=1 \
    -e GIT_SSH_COMMAND="$SSH_CMD" \
    "$CONTAINER" bash -lc 'export PATH="$HOME/.local/bin:$PATH"; '"$1"
}

log "booting $IMAGE"
docker run -d \
  --name "$CONTAINER" \
  --hostname discourse \
  --add-host "host.docker.internal:$BRIDGE_IP" \
  "$IMAGE" /sbin/boot >/dev/null

docker exec -u root "$CONTAINER" bash -c '
  set -e
  install -d -o discourse -g discourse -m 0700 /home/discourse/.ssh
  install -d -o discourse -g discourse /src
'
docker cp "$CLIENT_KEY" "$CONTAINER:/home/discourse/.ssh/gate"
docker exec -u root "$CONTAINER" chown discourse:discourse /home/discourse/.ssh/gate
docker exec -u root "$CONTAINER" chmod 600 /home/discourse/.ssh/gate

log "installing term-llm"
as_agent "curl -fsSL https://raw.githubusercontent.com/samsaffron/term-llm/${TERM_LLM_VERSION}/install.sh | sh"

log "cloning the branch"
as_agent "
  set -e
  git clone -q --depth 1 --branch '$HEAD_REF' ssh://$GATE_USER@host.docker.internal/relay.git /src
  cd /src
  git config user.name  'discoursebot'
  git config user.email 'discoursebot@users.noreply.github.com'
"

log "installing the agent"
docker exec -u root "$CONTAINER" install -d -o discourse -g discourse \
  /home/discourse/.config/term-llm/agents
docker cp "$AGENT_DIR/." "$CONTAINER:/home/discourse/.config/term-llm/agents/discoursebot"
docker cp "$RUNNER_TEMP/mcp.json" "$CONTAINER:/home/discourse/.config/term-llm/mcp.json"

# Inference goes back to the runner. The model named here is ignored by the
# far end, which answers with whatever provider it was started with.
printf '%s\n' \
  'default_provider: anthropic' \
  'providers:' \
  '  anthropic:' \
  "    base_url: http://host.docker.internal:$SERVE_PORT/ui" \
  "    api_key: $SERVE_TOKEN" \
  > "$RUNNER_TEMP/config.yaml"
docker cp "$RUNNER_TEMP/config.yaml" "$CONTAINER:/home/discourse/.config/term-llm/config.yaml"
docker exec -u root "$CONTAINER" chown -R discourse:discourse /home/discourse/.config

if [ -f "$RUNNER_TEMP/session/issue.db" ]; then
  log "restoring the earlier conversation"
  docker cp "$RUNNER_TEMP/session/issue.db" "$CONTAINER:/home/discourse/session.db"
  docker exec -u root "$CONTAINER" chown discourse:discourse /home/discourse/session.db
fi

log "waiting for postgres"
for _ in $(seq 1 60); do
  docker exec -u root "$CONTAINER" pg_isready -q 2>/dev/null && break
  sleep 2
done

log "preparing the app"
as_agent "bundle install --jobs $(nproc) --retry 3"
as_agent "pnpm install --frozen-lockfile"
as_agent "bin/rake db:create db:migrate"
as_agent "RAILS_ENV=test bin/rake db:create db:migrate"

log "running the agent"
resume=""
[ -f "$RUNNER_TEMP/session/issue.db" ] && resume="--resume"

docker cp "$RUNNER_TEMP/prompt.txt" "$CONTAINER:/home/discourse/prompt.txt"
set +e
as_agent "
  term-llm ask \
    --agent discoursebot \
    --provider anthropic \
    --session-db /home/discourse/session.db \
    $resume \
    --yolo \
    --text \
    --stats \
    --max-turns 200 \
    --timeout 30m \
    \"\$(cat /home/discourse/prompt.txt)\" 2>&1
" | sed -u -e 's/.*\r//'
status=${PIPESTATUS[0]}
set -e

mkdir -p "$RUNNER_TEMP/session"
docker cp "$CONTAINER:/home/discourse/session.db" "$RUNNER_TEMP/session/issue.db" 2>/dev/null || true

exit "$status"
