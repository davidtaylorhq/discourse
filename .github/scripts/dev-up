#!/bin/bash
# Bring up the Discourse development environment, once, on demand.
#
# It shares the work tree volume with the sandbox, so the agent's edits are
# already there. Most runs never call this and never wait for it.
set -euo pipefail

. "$HOME/.discoursebot/env"

CONTAINER=discourse_dev
IMAGE=discourse/discourse_dev:release

running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || echo false)" = true ]
}

exec 9>"${RUNNER_TEMP:-/tmp}/dev-up.lock"
flock 9
running && exit 0

# Before the agent's own line, not after it: the agent cannot finish until the
# environment it asked for is up, so a tick below a spinner reads as backwards.
"$PROGRESS" insert-before agent \
  dev_req="Requested development environment" \
  dev_ready="Development environment ready" || true
"$PROGRESS" set dev_req done || true

echo "[dev] starting $IMAGE" >&2
docker run -d \
  --name "$CONTAINER" \
  --hostname discourse \
  -v "$WORKTREE_VOLUME:/src" \
  -v "$POSTGRES_VOLUME:/shared/postgres_data" \
  "$IMAGE" /sbin/boot >/dev/null

# The sandbox writes the work tree as uid 1000; whatever this image calls that
# user has to agree, or neither side can read what the other wrote.
docker exec -u root "$CONTAINER" bash -c '
  set -e
  [ "$(id -u discourse)" = 1000 ] || {
    usermod -u 1000 discourse
    groupmod -g 1000 discourse
    chown -R 1000:1000 /home/discourse
  }
'

in_dev() {
  docker exec -i -u discourse -w /src -e CI=1 "$CONTAINER" bash -lc "$1"
}

echo "[dev] waiting for postgres" >&2
for _ in $(seq 1 60); do
  docker exec -u root "$CONTAINER" pg_isready -q 2>/dev/null && break
  sleep 2
done

echo "[dev] installing gems" >&2
in_dev "bundle install --jobs $(nproc) --retry 3" >&2
echo "[dev] installing node modules" >&2
in_dev "pnpm install --frozen-lockfile" >&2
echo "[dev] migrating" >&2
in_dev "bin/rake db:create db:migrate" >&2
in_dev "RAILS_ENV=test bin/rake db:create db:migrate" >&2

"$PROGRESS" set dev_ready done || true
echo "[dev] ready" >&2
